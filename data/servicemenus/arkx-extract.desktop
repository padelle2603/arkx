[Desktop Entry]
Type=Service
TryExec=arkx
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-tarz;application/x-xz-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-tzo;application/x-lrzip-compressed-tar;application/x-lz4-compressed-tar;application/x-zstd-compressed-tar;application/gzip;application/x-bzip;application/x-bzip2;application/x-xz;application/x-lzma;application/x-compress;application/zstd;application/x-lz4;application/x-iso9660-image;application/x-cd-image;application/vnd.ms-cab-compressed;application/x-bcpio;application/x-cpio;application/x-cpio-compressed;application/x-sv4cpio;application/x-sv4crc;application/x-xar;application/x-archive;application/x-source-rpm;application/x-rpm;application/x-lha;application/x-deb;
Actions=extractHere;extractTo;openWithArkx;
X-KDE-Submenu=Extract
X-KDE-Submenu[it]=Estrai
X-KDE-Priority=TopLevel
X-KDE-Protocols=file
X-KDE-MinNumberOfUrls=1
Icon=arkx

[Desktop Action extractHere]
Name=Extract here
Name[it]=Estrai qui
Icon=arkx
Exec=arkx extract --here --progress %F

[Desktop Action extractTo]
Name=Extract to...
Name[it]=Estrai in...
Icon=arkx
Exec=arkx extract --dialog --progress %F

[Desktop Action openWithArkx]
Name=Open with Arkx
Name[it]=Apri con Arkx
Icon=arkx
Exec=arkx %F
